{
  "name": "@apollo/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:desktop": "node scripts/dev.ts --desktop",
    "start": "pnpm --filter @apollo/desktop start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "pair": "APOLLO_DATA_DIR=${APOLLO_DATA_DIR:-.apollo-dev} APOLLO_PUBLIC_URL=${APOLLO_PUBLIC_URL:-http://127.0.0.1:5733} node apps/server/src/bin.ts pair",
    "package": "pnpm --filter @apollo/desktop package"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
